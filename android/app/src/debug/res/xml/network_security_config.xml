<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds also reach the test server on the emulator's host, which
     serves the updater's files over plain HTTP. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">appldnld.apple.com</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
